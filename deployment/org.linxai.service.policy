<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>LINxAI</vendor>
  <action id="org.linxai.service.manage">
    <description>Manage an explicitly permitted LINxAI service</description>
    <message>Authentication is required for this exact LINxAI service operation</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
  <action id="org.linxai.response.manage">
    <description>Manage a scoped LINxAI kernel response policy</description>
    <message>Authentication is required for this exact bounded kernel policy</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
  <action id="org.linxai.process.manage">
    <description>Restore the priority of one of your exactly identified processes</description>
    <message>Authentication is required to restore this exact process priority</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
  <action id="org.linxai.face.manage">
    <description>Manage your protected LINxAI face enrollment</description>
    <message>OS password authentication is required for account enrollment changes</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
</policyconfig>
