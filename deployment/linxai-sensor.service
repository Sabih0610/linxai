[Unit]
Description=LINxAI independent BCC kernel capture
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I -B /usr/lib/linxai-trusted/broker_entry.py sensor
User=root
Group=root
RuntimeDirectory=linxai-sensor
RuntimeDirectoryMode=0755
StateDirectory=linxai-sensor
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
